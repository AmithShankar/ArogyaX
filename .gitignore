# ArogyaX Master Gitignore

# --- IDEs, Editor & AI Context ---
.vscode/
.claude/
.code-review-graph/
.code-review-graphignore
.history/
.idea/
*.swp
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- OS Specific ---
.DS_Store
Thumbs.db

# --- Logs, Traces & Temp ---
*.log
*.har
scratch/

# --- Build Artifacts & Caches ---
*.tsbuildinfo

# --- Environments (Global Security) ---
.env
.env.*
!.env.example

# --- Python / Backend Specific ---
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
ENV/
# Use specific patterns for virtual environments to avoid ignoring src/lib
Include/
Scripts/
# Python build artifacts
build/
dist/
*.egg-info/
pyvenv.cfg
# Critical: Protect patient data
Backend/uploads/

# --- Node / Frontend Specific ---
node_modules/
.next/
dist/
build/
out/
Frontend/out/
Frontend/.next/
